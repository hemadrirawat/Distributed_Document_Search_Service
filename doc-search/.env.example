# Copy to .env before `docker compose up`. NEVER commit a real .env.
# In production every value below comes from a secrets manager
# (AWS Secrets Manager / Vault) injected at runtime, not from a file.

# --- application ---
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- postgres (source of truth) ---
POSTGRES_USER=docsearch
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=docsearch
DATABASE_URL=postgresql+asyncpg://docsearch:change-me-locally@postgres:5432/docsearch
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- redis (cache + rate limiting) ---
REDIS_URL=redis://redis:6379/0
SEARCH_CACHE_TTL_SECONDS=30
DOCUMENT_CACHE_TTL_SECONDS=60

# --- opensearch (search read model) ---
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_INDEX=documents
OPENSEARCH_SHARDS=3
OPENSEARCH_REPLICAS=0

# --- rabbitmq (asynchronous indexing) ---
RABBITMQ_USER=docsearch
RABBITMQ_PASSWORD=change-me-locally
RABBITMQ_URL=amqp://docsearch:change-me-locally@rabbitmq:5672/
MAX_INDEX_ATTEMPTS=3

# --- rate limiting ---
DEFAULT_RATE_LIMIT_PER_MINUTE=120

# --- PROTOTYPE ONLY: demo tenants and their API keys (tenant_id:api_key,...) ---
# Replaced in production by an identity provider issuing OIDC access tokens.
SEED_TENANTS=acme:acme-dev-key-001,globex:globex-dev-key-002
